{
 "cleanUrls": true,
 "trailingSlash": false,
 "rewrites": [
  {
   "source": "/meta/:id",
   "destination": "/meta/:id.json"
  },
  {
   "source": "/nft",
   "destination": "/nft.html"
  },
  {
   "source": "/collection",
   "destination": "/collection.html"
  }
 ],
 "headers": [
  {
   "source": "/meta/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}